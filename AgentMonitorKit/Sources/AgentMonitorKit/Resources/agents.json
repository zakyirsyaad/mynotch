[
  {
    "id": "claude-code",
    "displayName": "Claude Code",
    "match": {
      "executable": ["claude"],
      "argvContains": []
    },
    "appBundleIDs": ["com.anthropic.claudefordesktop"],
    "hooks": {
      "format": "claude",
      "config": "~/.claude/settings.json",
      "events": [
        "SessionStart",
        "UserPromptSubmit",
        "PostToolUse",
        "Notification",
        "Stop",
        "SubagentStart",
        "SubagentStop",
        "StopFailure",
        "SessionEnd"
      ]
    }
  },
